# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# HTTP
PORT=8080

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=url_shortener
DB_SSLMODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# App
BASE_URL=http://localhost:8080
MIGRATIONS_PATH=migrations

# Firebase (Level 5 — leave empty until Firebase project is created)
FIREBASE_PROJECT_ID=

# MaxMind GeoLite2 (Level 9 — leave empty to use "Unknown" fallback)
GEOIP_DB_PATH=

# Gin
GIN_MODE=debug
